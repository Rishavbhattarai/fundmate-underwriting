<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
<fullName>Factor_Rate_Range</fullName>
<active>true</active>
<description>Factor Rate must be between 1 and 5.</description>
<errorConditionFormula>OR(ISBLANK(Factor_Rate__c), Factor_Rate__c &lt; 1, Factor_Rate__c &gt; 5)</errorConditionFormula>
<errorDisplayField>Factor_Rate__c</errorDisplayField>
<errorMessage>Factor Rate must be between 1 and 5.</errorMessage>
</ValidationRule>
