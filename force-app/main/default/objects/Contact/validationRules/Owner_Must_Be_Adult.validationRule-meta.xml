<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
<fullName>Owner_Must_Be_Adult</fullName>
<active>true</active>
<description>Business owners must be at least 18.</description>
<errorConditionFormula>AND(NOT(ISBLANK(Ownership_Percentage__c)), REGEX(Date_of_Birth__c, "\\d{4}-\\d{2}-\\d{2}"), ADDMONTHS(DATEVALUE(Date_of_Birth__c), 216) &gt; TODAY())</errorConditionFormula>
<errorDisplayField>Date_of_Birth__c</errorDisplayField>
<errorMessage>Business owners must be at least 18.</errorMessage>
</ValidationRule>
