<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
<fullName>SSN_Format</fullName>
<active>true</active>
<description>SSN must be in 123-45-6789 format.</description>
<errorConditionFormula>AND(NOT(ISBLANK(SSN__c)), NOT(REGEX(SSN__c, "\\d{3}-\\d{2}-\\d{4}")))</errorConditionFormula>
<errorDisplayField>SSN__c</errorDisplayField>
<errorMessage>SSN must be in 123-45-6789 format.</errorMessage>
</ValidationRule>
