<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
<fullName>Statement_Month_Not_Future</fullName>
<active>true</active>
<description>Statement Month can't be in the future.</description>
<errorConditionFormula>Statement_Month__c &gt; TODAY()</errorConditionFormula>
<errorDisplayField>Statement_Month__c</errorDisplayField>
<errorMessage>Statement Month can't be in the future.</errorMessage>
</ValidationRule>
