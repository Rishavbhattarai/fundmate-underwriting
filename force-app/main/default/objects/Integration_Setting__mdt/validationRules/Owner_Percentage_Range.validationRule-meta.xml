<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
<fullName>Owner_Percentage_Range</fullName>
<active>true</active>
<description>Minimum Owner Percentage must be 0 to 100.</description>
<errorConditionFormula>OR(Min_Owner_Percentage__c &lt; 0, Min_Owner_Percentage__c &gt; 1)</errorConditionFormula>
<errorDisplayField>Min_Owner_Percentage__c</errorDisplayField>
<errorMessage>Minimum Owner Percentage must be 0 to 100.</errorMessage>
</ValidationRule>
