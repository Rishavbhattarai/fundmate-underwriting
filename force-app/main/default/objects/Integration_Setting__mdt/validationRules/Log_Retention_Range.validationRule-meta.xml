<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
<fullName>Log_Retention_Range</fullName>
<active>true</active>
<description>Log Retention Days must be 7 to 3,650.</description>
<errorConditionFormula>AND(NOT(ISBLANK(Log_Retention_Days__c)), OR(Log_Retention_Days__c &lt; 7, Log_Retention_Days__c &gt; 3650))</errorConditionFormula>
<errorDisplayField>Log_Retention_Days__c</errorDisplayField>
<errorMessage>Log Retention Days must be 7 to 3,650.</errorMessage>
</ValidationRule>
