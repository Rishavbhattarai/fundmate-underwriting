<?xml version="1.0" encoding="UTF-8"?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>Custom</authenticationProtocol>
    <description>Holds the Underwriting API key. Set the ApiKey value on the principal in Setup; it is never stored in source.</description>
    <externalCredentialParameters>
        <parameterGroup>UnderwritingPrincipal</parameterGroup>
        <parameterName>UnderwritingPrincipal</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <label>Underwriting API Credential</label>
</ExternalCredential>
