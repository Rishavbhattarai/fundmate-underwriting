    <description>Routes a Funding Application to a queue when its status becomes a decision (Approved, Declined, Needs More Info) or an integration exception (Rejected, Send Failed). Rules live in Routing_Rule__mdt (status, amount range, queue, priority), so admins change routing in Setup. The first active rule by priority whose range fits the Requested Amount wins.</description>
    <environments>Default</environments>
    <formulas>
        <description>True when the current rule fits the requested amount and no earlier rule matched.</description>
        <name>fxRuleMatches</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  ISBLANK({!varQueueDeveloperName}),
  OR(ISBLANK({!Loop_Rules.Min_Amount__c}), {!$Record.Requested_Amount__c} &gt;= {!Loop_Rules.Min_Amount__c}),
  OR(ISBLANK({!Loop_Rules.Max_Amount__c}), {!$Record.Requested_Amount__c} &lt;= {!Loop_Rules.Max_Amount__c})
)</expression>
    </formulas>
    <formulas>
        <name>fxNoRouteReason</name>
        <dataType>String</dataType>
        <expression>LEFT(&apos;No routing rule or queue matched; owner unchanged. &apos; &amp; {!$Record.Status_Reason__c}, 255)</expression>
    </formulas>
    <interviewLabel>Route Decided Funding Application {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Route Decided Funding Application</label>
